{
  "name": "@cestoliv/grove",
  "version": "0.1.2",
  "description": "Declarative self-hosted CI runner fleets for GitHub and GitLab.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cestoliv/grove.git"
  },
  "keywords": [
    "ci",
    "runners",
    "github-actions",
    "gitlab-runner",
    "self-hosted",
    "fleet"
  ],
  "homepage": "https://github.com/cestoliv/grove#readme",
  "bugs": {
    "url": "https://github.com/cestoliv/grove/issues"
  },
  "author": "Olivier Cartier <me@cestoliv.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.13.0"
  },
  "type": "module",
  "bin": {
    "grove": "./dist/grove.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx src/grove.ts",
    "build": "tsup && chmod +x dist/grove.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "yaml": "^2.8.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.0"
  }
}
